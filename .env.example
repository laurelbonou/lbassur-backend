# ─────────────────────────────────────────────────────────────────────────────
#  LBASSUR — Backend
#
#  Copier en `.env` et renseigner. Le fichier `.env` est ignoré par git.
#  Les variables marquées REQUIS sont validées au démarrage (src/config/
#  env.validation.ts) : sans elles, l'application refuse de booter.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────

# development | production | test. Défaut : development.
# EN PRODUCTION, posez-la explicitement : elle durcit la CSP, restreint le CORS
# et réduit la verbosité des logs.
NODE_ENV=development

# Ne PAS définir sur Render : la plateforme injecte son propre port.
PORT=4000

# REQUIS. Origines autorisées par le CORS, séparées par des virgules.
FRONTEND_URL=http://localhost:3000

# ── Base de données (Neon) ───────────────────────────────────────────────────

# REQUIS. Connexion applicative : utiliser l'hôte *pooler*.
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/<database>?sslmode=require"

# Connexion directe, utilisée par les migrations Prisma (hors pooler).
DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/<database>?sslmode=require"

# ── Authentification ─────────────────────────────────────────────────────────

# REQUIS. Signature des jetons d'accès des clients.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<chaine-aleatoire-longue>

# REQUIS. Signature des jetons de rafraîchissement. DOIT être différent du
# JWT_SECRET : si l'un fuite, il ne doit pas permettre de forger l'autre.
# Le modifier déconnecte tous les clients ayant une session ouverte.
REFRESH_TOKEN_SECRET=<autre-chaine-aleatoire-longue>

# Durée de validité des jetons de rafraîchissement. Défaut : 30d.
# REFRESH_TOKEN_EXPIRES_IN=30d

# REQUIS. Protège les endpoints d'administration (en-tête x-api-key).
# C'est la même valeur que l'ADMIN_API_KEY du projet lbassur-admin.
ADMIN_API_KEY=<chaine-aleatoire-longue>

# ── Stockage des fichiers (Cloudinary) ───────────────────────────────────────

# REQUIS. Photos et notes vocales de sinistre, justificatifs, signatures,
# reçus et contrats générés. Rien n'est écrit sur le disque de l'hébergeur.
# Se trouve dans la console Cloudinary : Settings > API Keys.
# Utiliser une clé distincte entre développement et production.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Paiements (FeexPay) ──────────────────────────────────────────────────────

# Identifiant de la boutique. Sans lui, le code retombe silencieusement sur
# "MOCK_SHOP_ID" : les paiements ne parviennent nulle part.
FEEXPAY_SHOP_ID=<votre-shop-id>

# OBLIGATOIRE EN PRODUCTION. Vérifie la signature des webhooks de paiement.
# Sans lui, le garde laisse passer toute requête : n'importe qui peut déclarer
# un paiement réussi. Optionnel en développement uniquement.
FEEXPAY_WEBHOOK_SECRET=<secret-fourni-par-feexpay>

# ── Emails (SMTP) ────────────────────────────────────────────────────────────

# Sans ces variables, aucun email ne part : ni reçu de paiement, ni contrat
# final au client, ni transmission du dossier à l'assureur. L'absence de
# SMTP_USER met l'envoi en mode simulé — les messages sont journalisés, pas
# expédiés, et aucune erreur n'est levée.
SMTP_HOST=mail.lbassur.bj
SMTP_USER=no-reply@lbassur.bj
SMTP_PASS=<mot-de-passe-de-la-boite>

# 465 = TLS implicite (chiffré dès l'ouverture), 587 = STARTTLS.
# Le chiffrement est déduit du port ; SMTP_SECURE ne sert qu'à forcer un cas
# particulier. Éviter le port 25 : les hébergeurs cloud bloquent sa sortie.
SMTP_PORT=465
# SMTP_SECURE=true

# Expéditeur affiché. DOIT être une adresse que le compte SMTP est autorisé à
# utiliser, sinon rejet ou classement en indésirable.
SMTP_FROM="LBASSUR <no-reply@lbassur.bj>"

# Adresse vers laquelle partent les réponses des clients. Sans elle, répondre à
# un reçu ou à un contrat n'aboutit nulle part.
SMTP_REPLY_TO=contact@lbassur.bj

# ── Destinataires des notifications ──────────────────────────────────────────

# Alertes internes : nouveau dossier, panier abandonné, paiement reçu.
ADMIN_EMAIL=contact@lbassur.bj
ADMIN_PHONE=<numero-au-format-international>

# Destinataire des dossiers transmis. INSURER_EMAIL est prioritaire ;
# INSURER_MOCK_EMAIL sert de repli pour les tests.
INSURER_EMAIL=<contact@compagnie.bj>
# INSURER_MOCK_EMAIL=insurer@example.com

# ── « Se connecter avec ACAB » (espace partenaires) ───────────────────────────

# OAuth 2.0, flux authorization code. L'ACAB atteste qu'un cabinet est adhérent
# et renvoie son numéro d'identification, sa dénomination et son statut. Elle ne
# transmet jamais d'email ni de téléphone : son annuaire n'est pas un fichier de
# prospection. Ne rien construire qui suppose le contraire.
ACAB_BASE_URL=https://acab-backend.onrender.com
ACAB_CLIENT_ID=<identifiant-client-fourni-par-l-acab>

# Ne sert QUE sur l'appel serveur POST /oauth/token. Jamais dans une URL, un
# journal, ni côté navigateur.
ACAB_CLIENT_SECRET=<secret-client-fourni-par-l-acab>

# Doit correspondre AU CARACTÈRE PRÈS à une URI enregistrée côté ACAB : la
# comparaison y est stricte, sans normalisation. Un slash final en trop suffit
# à faire échouer toute connexion.
#   production  : https://lbassur-backend.onrender.com/api/v1/auth/acab/callback
#   local       : http://localhost:4000/api/v1/auth/acab/callback
ACAB_REDIRECT_URI=http://localhost:4000/api/v1/auth/acab/callback

# Espace courtiers et agents généraux, vers lequel le navigateur est renvoyé en
# fin de parcours. Sans slash final.
ESPACE_PARTENAIRES_URL=http://localhost:3002
